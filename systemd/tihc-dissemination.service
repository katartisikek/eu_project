[Unit]
Description=TIHC Dissemination Monitoring & Reporting Platform
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/tihc-dissemination
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=PORT=3080
Environment=HOST=127.0.0.1

# Security sandbox
ProtectSystem=full
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

